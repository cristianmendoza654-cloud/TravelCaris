{
  "name": "travelcaris",
  "version": "3.3.1",
  "description": "Organizador familiar de viajes, itinerarios, vuelos, mapas, reservas y gastos",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
